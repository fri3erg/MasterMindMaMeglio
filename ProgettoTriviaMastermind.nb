Cell[CellGroupData[{

Cell["Fine della Partita", "Subsubsection",
 CellChangeTimes->{{3.953004557365568*^9, 3.9530045873935566`*^9}, 
   3.9566672721946087`*^9},ExpressionUUID->"b6cd82b2-a133-fc4b-bbe8-\
be3e2d0ca442"],

Cell[TextData[{
 "Se il giocatore indovina il codice entro il numero massimo di tentativi, ",
 StyleBox["vince la partita",
  FontWeight->"Bold"],
 ". Altrimenti, ",
 StyleBox["viene sconfitto",
  FontWeight->"Bold"],
 ".\nIn ogni caso, al termine della partita viene mostrata una finestra di \
dialogo con l\[CloseCurlyQuote]avviso di vittoria o sconfitta, e all\
\[CloseCurlyQuote]interno di questa finestra viene anche data la possibilit\
\[AGrave] di ",
 StyleBox["ricominciare la partita con lo stesso seed",
  FontSlant->"Italic"],
 " o semplicemente tornare al men\[UGrave] tramite il tasto \
\[OpenCurlyQuote]QUIT\[CloseCurlyQuote].\nSi pu\[OGrave] anche chiudere \
questa finestra di dialogo con il tasto \[OpenCurlyQuote]close dialog\
\[CloseCurlyQuote].\n\nIn qualsiasi momento \[EGrave] possibile ",
 StyleBox["abbandonare la partita",
  FontSlant->"Italic"],
 " in corso e tornare al men\[UGrave] con il tasto \[OpenCurlyQuote]\
\[LongLeftArrow]\[CloseCurlyQuote] in alto.\nSi pu\[OGrave] ",
 StyleBox["chiudere il programma",
  FontSlant->"Italic"],
 " con il tasto \[OpenCurlyQuote]QUIT\[CloseCurlyQuote] presente nel men\
\[UGrave]."
}], "Text",
 CellChangeTimes->{{3.953004551563715*^9, 3.9530046344878254`*^9}, {
  3.954838160274866*^9, 3.954838195577881*^9}, {3.955810233559187*^9, 
  3.955810410826414*^9}, {3.9563706859770584`*^9, 3.9563707363561726`*^9}, {
  3.9563946114416714`*^9, 3.956394612321707*^9}, {3.9563946437903576`*^9, 
