Cell[CellGroupData[{

Cell["Introduzione al Programma", "Section",
 CellChangeTimes->{{3.9525952505427876`*^9, 3.952595258190151*^9}, {
  3.9525956195457363`*^9, 
  3.9525956249696846`*^9}},ExpressionUUID->"6827955b-ce5f-f848-80cd-\
e50789846624"],

Cell[TextData[{
 "Il ",
 StyleBox["Trivia Mastermind",
  FontWeight->"Bold"],
 " \[EGrave] una variante del classico gioco di crittoanalisi da tavolo ",
 StyleBox["Mastermind",
  FontWeight->"Bold"],
 " ",
 ButtonBox["[1]",
  BaseStyle->"Hyperlink",
  ButtonData->"Wikipedia_Mastermind"],
 ", il cui obiettivo \[EGrave] indovinare entro un numero limitato di \
tentativi una ",
 StyleBox["combinazione segreta di colori",
  FontWeight->"Bold"],
 ", detta ",
 StyleBox["codice",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQAmIQ/YDHVuNX0VvHD6tKdEB0i+WrUBB9J0g7CkTvEF5S
d7D4raOMmHM9iPboYW8G0Vci2rtBdEnA/4kgumfOsukg+sicg3NBdMTHU/NB
tEjC1Gsg2sLv2k0QHZP46cUhID1Bc/0rEL2mcRfHYSCtMglCx2Rt+3QMZE7L
lv8g2sD+BudxID2D1ZMfRDfMfy0Jolscq+VB9JqfX8VPgNxTxKsEonu2a6mB
6D+puXogOuKyoxWIluDptwXRe37sKwHRHTy/qkC0CjtbPYh+kF/dBKIrFi1r
B9Eap3WmgugV+8NngmibnVwbQPSFuknbwOoOLt8Oot+0pb8SrnzryFH6/g2I
Fuj48Q3MD1L7DqINEqo+iyLRDz5/sLaoAvpPZq09iC4RPucOogu2TfMB0Ve8
l+eA5XuzC0A0AAh64OU=
  "],ExpressionUUID->"79c2c610-7e0b-f346-bb4a-fb0cdae303ce"],

Cell[TextData[{
 "Ad ogni turno, il giocatore prova a indovinare tale codice e riceve un ",
 StyleBox["feedback",
  FontWeight->"Bold"],
 " sulla correttezza del suo tentativo. Rispetto alla versione di Mastermind \
originale, questo feedback \[EGrave] pi\[UGrave] informativo, in quanto, al \
posto di indicare solo il numero di colori nella posizione corretta e quelli \
nella posizione sbagliata, \[EGrave] anche chiaro a quale colore si riferisce \
grazie alla sua posizione. Questo lo rende simile al sistema di feedback del \
rompicapo ",
 StyleBox["Wordle",
  FontSlant->"Italic"],
 " ",
 ButtonBox["[2]",
  BaseStyle->"Hyperlink",
  ButtonData->"Wordle"],
 " e suoi derivati."
}], "Text",
 CellChangeTimes->{
  3.953018297619215*^9, {3.953018521701229*^9, 3.9530185225503273`*^9}, {
   3.9530197067934265`*^9, 3.9530197942814217`*^9}, {3.9530198929024315`*^9, 
   3.953019920657831*^9}, {3.953525881218567*^9, 3.953525886977869*^9}, {
   3.955766445364746*^9, 3.9557664564550533`*^9}, {3.955793903181261*^9, 
   3.955793916798996*^9}, {3.955797534029665*^9, 3.9557975786756077`*^9}, {
   3.955797729642149*^9, 3.955797740621374*^9}, {3.955797796201103*^9, 
   3.9557978285029984`*^9}, {3.955797870761175*^9, 3.9557978707624035`*^9}, {
   3.956368139594452*^9, 3.9563681402010155`*^9}, {3.956392565292843*^9, 
   3.956392630620249*^9}, {3.956392909520527*^9, 3.9563929123974037`*^9}, {
   3.9563929664520435`*^9, 3.9563929804660664`*^9}, {3.956393196285406*^9, 
   3.956393239132576*^9}, {3.9566651900894356`*^9, 3.9566652213439674`*^9}, {
   3.9566652609527855`*^9, 
   3.9566652765350647`*^9}},ExpressionUUID->"b35c3540-3144-8943-a285-\
3724195b37b3"],

Cell[TextData[{
 "Al posto di tentare a vuoto, il giocatore pu\[OGrave] anche chiedere un ",
 StyleBox["suggerimento",
  FontWeight->"Bold"],
 " (una volta per turno): a condizione di ",
 StyleBox["rispondere correttamente a una domanda di trivia",
  FontSlant->"Italic"],
 ", si pu\[OGrave] scoprire uno dei colori presenti nel codice, o, se sono gi\
\[AGrave] tutti noti, si scopre la posizione di uno dei colori gi\[AGrave] \
trovati."
}], "Text",
 CellChangeTimes->{
  3.953018303644039*^9, {3.9557939472902317`*^9, 3.9557940147291813`*^9}, {
   3.9563926713356056`*^9, 
   3.9563926884924374`*^9}},ExpressionUUID->"51daa29c-dde2-ec47-83ce-\
d04b82781ea5"],

Cell[CellGroupData[{

Cell["Dinamica di Gioco", "Subsection",
 CellChangeTimes->{{3.9530042759249477`*^9, 
  3.953004279249813*^9}},ExpressionUUID->"55bd708c-3894-534b-8f5f-\
28fd80081cca"],

Cell[CellGroupData[{

Cell["Setup iniziale", "Subsubsection",
 CellChangeTimes->{{3.953004364848961*^9, 3.9530043669901695`*^9}, 
   3.9566672700729294`*^9},ExpressionUUID->"eb9e00c1-85b5-3440-956a-\
745d1a83fe71"],

Cell[TextData[{
 "Prima di iniziare la partita, il giocatore deve inserire un",
 StyleBox[" numero intero positivo",
  FontWeight->"Bold"],
 " (o ne genera casualmente uno da 0 a 9999 col tasto \[OpenCurlyQuote]\:21bb\
\[CloseCurlyQuote]) da usare come ",
 StyleBox["seed",
  FontWeight->"Bold"],
 " per la partita.\nInoltre, pu\[OGrave] modificare alcuni parametri di gioco \
come pi\[UGrave] preferisce. Si pu\[OGrave] modificare il ",
 StyleBox["numero di tentativi",
  FontWeight->"Bold"],
 " concessi, la ",
 StyleBox["lunghezza del codice",
  FontWeight->"Bold"],
 " da indovinare, e si pu\[OGrave] permettere o meno la presenza di ",
 StyleBox["colori ripetuti",
  FontWeight->"Bold"],
 " nel codice (ma poich\[EGrave] ogni combinazione \[EGrave] casuale, non \
\[EGrave] detto che la loro presenza sia garantita)."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQAWIQXRFQev9g8VtHnytlb0G0hIX6dxC9p2HPDxD9RN/5
P4ie07cBTL9oVeQ5BKT/7C3nB9Etf0vngugHU6vANEOO1bETQPqMu89xEP2H
