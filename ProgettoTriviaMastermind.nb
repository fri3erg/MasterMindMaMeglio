Cell[TextData[{
 "Con l\[CloseCurlyQuote]avvio della partita tramite il tasto \
\[OpenCurlyQuote]\[FilledRightTriangle]\[CloseCurlyQuote], viene generato il \
codice segreto casuale con i parametri selezionati, e il giocatore \
pu\[OGrave] iniziare a indovinarlo.\nSi trover\[AGrave] in una nuova \
schermata dove, da sinistra a destra, trover\[AGrave]: la ",
 StyleBox["palette dei colori",
  FontSlant->"Italic"],
 ", i ",
 StyleBox["tentativi del giocatore",
  FontSlant->"Italic"],
 ", il",
 StyleBox[" feedback",
  FontSlant->"Italic"],
 ", e i ",
 StyleBox["tasti \[OpenCurlyQuote]Check\[CloseCurlyQuote] ed \
\[OpenCurlyQuote]Hint\[CloseCurlyQuote]",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.956668025104164*^9, 
  3.956668026676241*^9}},ExpressionUUID->"c5e952a5-5217-b54d-be2f-\
89530180d63e"],

