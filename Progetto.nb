   3.952596425569933*^9, 3.9525965098212585`*^9}, {3.952739757461231*^9, 
   3.95273977466485*^9}, {3.9530234711166306`*^9, 3.9530234819018097`*^9}, {
   3.9530235405482616`*^9, 3.9530235817999725`*^9}, {3.9530274430066223`*^9, 
   3.9530274854481125`*^9}, {3.953027515512985*^9, 3.953027515512985*^9}, {
   3.953606647532791*^9, 3.9536066510731144`*^9}, {3.953606682037573*^9, 
   3.9536066961281376`*^9}, {3.9536067263701496`*^9, 3.953606766376642*^9}, {
   3.9536068048506813`*^9, 3.953606873819748*^9}, {3.953607013462818*^9, 
   3.9536070341263847`*^9}, {3.9536071904125977`*^9, 3.953607197215809*^9}, 
   3.953731950441654*^9, {3.9557204194235134`*^9, 3.9557204194235134`*^9}, {
   3.955766911469494*^9, 3.9557669177358723`*^9}, 3.955766948341465*^9, {
   3.9557670021015415`*^9, 3.9557671508361855`*^9}, {3.9557671923445053`*^9, 
